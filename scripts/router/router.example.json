{
  "version": 1,
  "roles": [
    {
      "name": "frontend",
      "agent": "frontend",
      "tier": "standard",
      "paths": ["src/components/**", "src/pages/**", "src/styles/**", "app/**", "**/*.{tsx,jsx,vue,svelte,css,scss}"],
      "keywords": ["ui", "component", "page", "css", "tailwind", "style", "button", "form", "modal", "layout", "responsive", "react", "frontend", "front-end", "render", "hook"]
    },
    {
      "name": "backend",
      "agent": "backend",
      "tier": "standard",
      "paths": ["src/api/**", "src/server/**", "src/services/**", "server/**", "api/**"],
      "keywords": ["api", "endpoint", "route", "handler", "middleware", "controller", "service", "server", "backend", "back-end", "request", "response", "webhook", "rate limit"]
    },
    {
      "name": "data",
      "agent": "data",
      "tier": "standard",
      "paths": ["prisma/**", "migrations/**", "db/**", "src/db/**", "**/*.sql"],
      "keywords": ["database", "schema", "migration", "sql", "query", "table", "column", "index", "orm", "prisma", "seed", "backfill"]
    },
    {
      "name": "qa",
      "agent": "test-runner",
      "tier": "fast",
      "paths": ["test/**", "tests/**", "e2e/**", "**/*.{test,spec}.*"],
      "keywords": ["test", "spec", "coverage", "flaky", "e2e", "lint", "ci", "regression", "assertion"]
    }
  ],
  "tiers": { "fast": "haiku", "standard": "sonnet", "deep": "opus" },
  "thresholds": { "confidence": 0.55 },
  "defaults": { "role": "main" },
  "log": true
}
